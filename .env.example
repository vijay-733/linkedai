# ─── LinkedIn OAuth (optional — get from https://developer.linkedin.com) ─────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change_this_to_a_long_random_string_in_production
NODE_ENV=development

# ─── AI Provider ──────────────────────────────────────────────────────────────
# No API key needed — app uses Pollinations.ai (free, no account required)
